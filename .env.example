# Paid Media AI Skills — Environment Variables
# Copy this file to .env and fill in the keys for the skills you're using.
# You only need keys for skills you actually use.

# ─────────────────────────────────────────
# Meta Marketing API (meta-ads-api)
# developers.facebook.com → Your App → Marketing API
# ─────────────────────────────────────────
META_ACCESS_TOKEN=your_long_lived_access_token
META_AD_ACCOUNT_ID=act_your_ad_account_id
META_APP_ID=your_facebook_app_id
META_APP_SECRET=your_facebook_app_secret
META_API_VERSION=v20.0

# ─────────────────────────────────────────
# Google Ads API (google-ads-api)
# Google Ads API Center → Developer Token
# Google Cloud Console → OAuth 2.0 credentials
# ─────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_oauth_refresh_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_mcc_account_id_no_dashes

# ─────────────────────────────────────────
# Shopify Admin API (shopify-integration)
# Shopify Admin → Apps → Develop apps → Create app
# Required scopes: read_orders, read_customers, read_products
# ─────────────────────────────────────────
SHOPIFY_SHOP_URL=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_your_admin_api_token
SHOPIFY_API_VERSION=2024-10

# ─────────────────────────────────────────
# Google Analytics 4 (ga4-integration)
# Google Cloud Console → Service Account → JSON key
# GA4 Admin → Property Access → add service account email
# ─────────────────────────────────────────
GA4_PROPERTY_ID=properties/123456789
GA4_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/ga4-service-account.json
